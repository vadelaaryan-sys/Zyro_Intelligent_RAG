# Example Streamlit Secrets Configuration
# -------------------------------------------------------------
# For local development with Streamlit:
# 1. Copy this file and rename it to: .streamlit/secrets.toml
# 2. Replace the placeholder below with your real Groq API key: https://console.groq.com/keys
# 3. NEVER commit secrets.toml or expose your API keys in version control!
# -------------------------------------------------------------

GROQ_API_KEY = "gsk_your_groq_api_key_here"
